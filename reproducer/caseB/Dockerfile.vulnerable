# Case B — vulnerable checkpoint.
# log4j-core 2.16.0  (apache/logging-log4j2 rel/2.16.0
#                     commit 70638718e0db900552c062b98956a05409d70058)
#
# 2.16.0 closed the Case A JNDI RCE class but still recurses without bound on a
# self-referential ${ctx:...} lookup (CVE-2021-45105). The DoS canary trips here.
#
# We pin the RELEASED Maven artifact (2.16.0); the SHA above is provenance only.
# A bounded stack is set so unbounded recursion trips deterministically and fast
# rather than thrashing the sandbox.
# EFFECT-ONLY (RFC 0003 / RFC 0001 inv. 8): DoS canary only; no code exec.

FROM maven:3.9-eclipse-temurin-8 AS build
WORKDIR /src
COPY driver/pom.xml .
COPY driver/src ./src
RUN mvn -B -Dlog4j.version=2.16.0 -q clean package

FROM eclipse-temurin:8-jre
WORKDIR /app
COPY --from=build /src/target/caseB-jar-with-dependencies.jar /app/caseB.jar
COPY --from=build /src/target/classes/log4j2.xml /app/log4j2.xml
ENV LOG4J_CONFIGURATION_FILE=/app/log4j2.xml
# -Xss512k bounds the stack so unbounded recursion trips the canary quickly.
ENTRYPOINT ["java", "-Xss512k", "-Dlog4j.configurationFile=/app/log4j2.xml", "-jar", "/app/caseB.jar"]
