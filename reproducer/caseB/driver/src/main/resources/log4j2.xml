<?xml version="1.0" encoding="UTF-8"?>
<!--
  Case B layout. A plain console layout is enough: the recursion is driven by the
  self-referential ${ctx:x} value the driver sets, not by the layout. Identical
  across both checkpoints so the two traces compare like-for-like.
-->
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Root level="error">
      <AppenderRef ref="Console"/>
    </Root>
  </Loggers>
</Configuration>
