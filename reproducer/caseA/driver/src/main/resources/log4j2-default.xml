<?xml version="1.0" encoding="UTF-8"?>
<!--
  Default PatternLayout. Used by the `vulnerable` (2.14.1) checkpoint, where the
  JNDI lookup fires through the message itself and no non-default layout is needed.
-->
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Root level="error">
      <AppenderRef ref="Console"/>
    </Root>
  </Loggers>
</Configuration>
