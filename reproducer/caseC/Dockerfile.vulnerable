# Case C — vulnerable checkpoint.
# log4j-core 2.17.0  (apache/logging-log4j2 rel/2.17.0
#                     commit 8285c82d998164dccfb2e57889b9dfb73dc27533)
#
# 2.17.0 closed the Case B DoS but still allows a JDBC Appender whose DataSource
# is resolved from an attacker-controlled JNDI name (CVE-2021-44832). Gated on the
# precondition `attacker_controlled_logging_config` -- supplied here as the bundled
# log4j2-jdbc.xml whose DataSource jndiName points at the collaborator.
#
# We pin the RELEASED Maven artifact (2.17.0); the SHA above is provenance only.
# EFFECT-ONLY (RFC 0003 / RFC 0001 inv. 8): observable = outbound connection
# attempt to the collaborator; no code exec, no payload served.

FROM maven:3.9-eclipse-temurin-8 AS build
WORKDIR /src
COPY driver/pom.xml .
COPY driver/src ./src
RUN mvn -B -Dlog4j.version=2.17.0 -q clean package

FROM eclipse-temurin:8-jre
WORKDIR /app
COPY --from=build /src/target/caseC-jar-with-dependencies.jar /app/caseC.jar
# Attacker-controlled config (the recorded precondition).
COPY --from=build /src/target/classes/log4j2-jdbc.xml /app/log4j2.xml
ENV LOG4J_CONFIGURATION_FILE=/app/log4j2.xml
# COLLABORATOR_JNDI (e.g. ldap://collaborator:1389/datasource) is injected by the sandbox.
ENTRYPOINT ["java", "-Dlog4j.configurationFile=/app/log4j2.xml", "-jar", "/app/caseC.jar"]
