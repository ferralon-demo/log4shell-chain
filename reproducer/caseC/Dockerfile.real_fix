# Case C — real_fix checkpoint.
# log4j-core 2.17.1  (apache/logging-log4j2 rel/2.17.1
#                     commit d1c64aa458c20b101a8dd5f4491848f087155e08)
#
# 2.17.1 restricted the JDBC Appender DataSource to the java: protocol and
# forbade JNDI lookups for it, closing CVE-2021-44832. Under the two-trace
# requirement the same attacker-controlled config (and the same precondition
# `attacker_controlled_logging_config`) that fired on 2.17.0 goes DARK here
# -> proven not_exploitable (PoNE). The condition is still recorded so the two
# traces compare like-for-like.
#
# We pin the RELEASED Maven artifact (2.17.1); the SHA above is provenance only.
# EFFECT-ONLY (RFC 0003 / RFC 0001 inv. 8).

FROM maven:3.9-eclipse-temurin-8 AS build
WORKDIR /src
COPY driver/pom.xml .
COPY driver/src ./src
RUN mvn -B -Dlog4j.version=2.17.1 -q clean package

FROM eclipse-temurin:8-jre
WORKDIR /app
COPY --from=build /src/target/caseC-jar-with-dependencies.jar /app/caseC.jar
COPY --from=build /src/target/classes/log4j2-jdbc.xml /app/log4j2.xml
ENV LOG4J_CONFIGURATION_FILE=/app/log4j2.xml
ENTRYPOINT ["java", "-Dlog4j.configurationFile=/app/log4j2.xml", "-jar", "/app/caseC.jar"]
